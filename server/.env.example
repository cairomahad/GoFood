# ──────────────────────────────────────────────────────────────
# GoFoods Backend — Environment Variables
# ──────────────────────────────────────────────────────────────

# ─── Сервер ───────────────────────────────────────────────────
PORT=3001

# ─── Telegram боты ────────────────────────────────────────────
# Получить через @BotFather

# Бот для покупателей (основной)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Бот для поваров (отдельный)
COOK_BOT_TOKEN=9876543210:ZYXwvuTSRqponMLKjihgFEDcba

# URL где развёрнут React сайт (Mini App)
MINI_APP_URL=https://gofoods-pi.vercel.app

# ─── Supabase ─────────────────────────────────────────────────
# https://app.supabase.com → Ваш проект → Settings → API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Public key (для фронтенда)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Service Role (для сервера, СЕКРЕТНЫЙ!)

# ─── Uber Direct ──────────────────────────────────────────────
# Зарегистрироваться на https://developer.uber.com
# Create App → Enable Uber Direct

UBER_CLIENT_ID=your_uber_client_id
UBER_CLIENT_SECRET=your_uber_client_secret
UBER_CUSTOMER_ID=your_customer_id

# ─── Mapbox (для адресов) ─────────────────────────────────────
# Используется на фронтенде, но может понадобиться и тут
MAPBOX_TOKEN=pk.eyJ1...

# ──────────────────────────────────────────────────────────────
# Как получить все эти ключи — см. SETUP.md
# ──────────────────────────────────────────────────────────────
